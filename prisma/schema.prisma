generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  xUsername     String?
  xId          String?
  accounts Account[]
  sessions Session[]
  settings UserSettings?
  ideas    Idea[]
  posts    Post[]
  drafts   Draft[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  claudeApiKey  String?
  chatgptApiKey String?
  geminiApiKey  String?
  grokApiKey    String?
  defaultLlm String @default("claude")
  defaultTone      String @default("casual")
  defaultLength    String @default("medium")
  hashtagCount     Int    @default(2)
  emojiLimit       Int    @default(2)
  targetAudience   String @default("general")
  brandVoice       String @default("")
  ngWords          String @default("")
  schedulePrefs String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Idea {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  category    String  @default("general")
  tags        String  @default("")
  priority    Int     @default(0)
  sortOrder   Int     @default(0)
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  drafts Draft[]
  posts  Post[]
}

model Draft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId String?
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  content       String
  llmProvider   String
  llmModel      String
  qualityScore      Float  @default(0)
  engagementScore   Float  @default(0)
  clarityScore      Float  @default(0)
  hookScore         Float  @default(0)
  replyPotential    Float  @default(0)
  controversyRisk   Float  @default(0)
  coachingAdvice    String @default("")
  additionalInfo    String @default("")
  tone        String @default("")
  targetAudience String @default("")
  hashtags    String @default("")
  charCount   Int    @default(0)
  isSelected Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post Post?
}

model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId  String?
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  draftId String? @unique
  draft   Draft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)
  content     String
  llmProvider String
  llmModel    String
  qualityScore    Float @default(0)
  engagementScore Float @default(0)
  status    String   @default("confirmed")
  postedAt  DateTime?
  scheduledAt DateTime?
  xPostId   String?
  likes       Int @default(0)
  retweets    Int @default(0)
  replies     Int @default(0)
  impressions Int @default(0)
  bookmarks   Int @default(0)
  coachingAdvice String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
